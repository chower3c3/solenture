{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/history", "destination": "/about/", "permanent": true },
    { "source": "/management-consulting", "destination": "/consulting/", "permanent": true },
    { "source": "/c-suite-executive-office", "destination": "/total-rewards/", "permanent": true },
    { "source": "/executive-family-office", "destination": "/wealth-management/", "permanent": true },
    { "source": "/offices", "destination": "/contact/", "permanent": true },
    { "source": "/files/content/privacy-policy-2026.pdf", "destination": "/privacy-policy/", "permanent": true },
    { "source": "/files/content/20260205_formcrs_173760_reedmark_advisors_llc.pdf", "destination": "/20260205_formcrs_173760_reedmark_advisors_llc.pdf", "permanent": true },
    { "source": "/files/content/20260312-adv-part-2a.pdf", "destination": "/20260312_ADV_Part_2A.pdf", "permanent": true }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
